{
	// The autonomous knowledge library Worker. Flue contributes the generated entry and the
	// per-agent Durable Object bindings (flueWorkerConfig() in vite.config.ts);
	// everything else is authored here.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "library",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": { "enabled": true },
	// Electric Agents in k3s, through Cloudflare
	// Tunnel b5c8a1b2-99d5-4914-b64a-a7874383cb5e: FLUE_STREAMS is the binding
	// every instance's inbox and events stream are reached through. Pi's own
	// state stays in each agent's Durable Object SQLite.
	"vpc_services": [
		{ "binding": "FLUE_STREAMS", "service_id": "01a0f462-e30b-7df3-bae8-e64c24c720c7" }
	],
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// Adding an agent = a new 'use agent' module, its mount in app.ts, and a
	// migration for its generated class (`Flue<Name>Agent`).
	"migrations": [
		{
			"tag": "society-v1",
			"new_sqlite_classes": ["FlueAliceAgent", "FlueBobAgent", "FlueCuratorAgent", "QualReplica"]
		},
		// The qualification build's scratch object rebuilt instances from their
		// Pi log; there is no Pi log any more.
		{ "tag": "society-v2", "deleted_classes": ["QualReplica"] },
		{ "tag": "society-v3", "new_sqlite_classes": ["FlueStewardAgent", "FlueSageAgent"] },
		{ "tag": "library-v1", "new_sqlite_classes": ["FlueLibrarianAgent"] }
	],
	// The `ops` MCP server: a service binding, since a Worker cannot fetch
	// another workers.dev Worker of its account. The steward sends the
	// OPS_MCP_TOKEN secret as its bearer token.
	"services": [{ "binding": "OPS", "service": "library-ops" }],
	"vars": {
		// The agents-server's own root: it serves the Durable Streams protocol and
		// the subscription API (/__ds/subscriptions) there. The VPC binding
		// routes the cluster-local name.
		"FLUE_STREAMS_URL": "http://fabric-society-electric.fabric-society.svc.cluster.local:4437",
		"FLUE_STREAMS_JWKS_URL": "http://fabric-society-electric.fabric-society.svc.cluster.local:4437/__ds/jwks.json",
		"FLUE_STREAMS_WEBHOOK_URL": "https://library.nymphai.workers.dev/__flue/streams/wake",
		// scripted | live
		"LIBRARY_MODEL": "scripted",
		// The real model: Muse Spark 1.3 Contributor on Meta's Model API, keyed by the
		// META_API_KEY secret.
		"LIVE_MODEL": "meta/muse-spark-1.3-contributor",
		// The steward's questions expire after 30 minutes.
		"QUESTION_TIMEOUT_MS": "1800000",
		"SCRIPTED_TOKENS_PER_SECOND": "50",
		// Serves /qual/* when the build compiled it in (QUALIFICATION=1 vite build).
		"QUALIFICATION": "1"
	}
}
