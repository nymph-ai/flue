{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": ["demo/**"],
	"ignoreDependencies": ["@flue/cli", "agents", "wrangler", "cloudflare"],
	"ignoreIssues": {
		"packages/runtime/src/runtime/schemas.ts": ["duplicates"],
		"packages/runtime/src/sandbox.ts": ["duplicates"],
		"packages/runtime/src/streams/*.ts": ["exports", "types"],
		"packages/runtime/src/entity/*.ts": ["exports", "types"],
		// The Flue Pi adapter (PI_UPGRADE_PLAN.md §7 steps 6, 10, 11) is not wired
		// into the coordinators until step 8; its exports are its public surface.
		"packages/runtime/src/pi/*.ts": ["exports", "types"],
		"examples/cloudflare/src/sandboxes/cloudflare-computer.ts": ["exports", "types"]
	},
	"workspaces": {
		".": {
			"entry": [".flue/{app,cloudflare,agents/*,workflows/*}.{ts,mts,js,mjs}"],
			"project": [".flue/**/*.{ts,mts,js,mjs}"],
			"ignoreDependencies": ["bgproc", "just-bash"]
		},
		"examples/*": {
			"entry": [
				"{src/{app,db,cloudflare,agents/*,channels/*},flue.config,vite.config,vite.config.cloudflare,vite.config.ui}.{ts,mts,js,mjs}"
			],
			"project": ["src/**/*.{ts,mts,js,mjs}"]
		},
		"examples/vitest-evals": {
			"entry": ["src/evals/**/*.eval.ts", "src/agents/*.ts", "src/app.ts", "flue.config.ts"],
			"project": ["src/**/*.ts", "*.ts"]
		},

		"apps/www": {
			"entry": [
				"src/homepage-shaders.ts",
				"src/pages/**/*.{astro,md,mdx}",
				"src/layouts/**/*.astro"
			]
		},
		"packages/runtime": {
			// src/pi/host.ts: the Pi adapter entry until the step-8 cutover imports it.
			"entry": ["test/fixtures/durable-boundary-child.mjs", "src/pi/host.ts"],
			"ignoreDependencies": [
				"@hono/node-server",
				// consumed by the Pi adapter (PI_UPGRADE_PLAN.md §7)
				"@earendil-works/chord",
				"@earendil-works/pi-codemode",
				"@earendil-works/pi-durable",
				"@earendil-works/pi-mcp"
			]
		},
		"packages/vite": {
			"ignoreDependencies": ["@earendil-works/pi-ai"]
		}
	}
}
