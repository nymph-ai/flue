{
	// Workers-pool test Worker (vitest.workers.config.ts). Code Mode runs its
	// scripts in Dynamic Workers (a Worker Loader binding) and keeps its
	// runtime in a Durable Object Facet of the agent: CodemodeTestAgent stands
	// in for an AgentDO. CODEMODE_RUNTIME is a test-only binding so that
	// ctx.exports offers the facet class under vitest-pool-workers; a real
	// Worker needs no binding or migration for it. SQLITE_PROBE holds Flue's
	// Durable Object storage adapters (src/cloudflare/workers); FIRST_WAKE is an
	// agent's Durable Object as the generated entry builds it, over the Agents
	// SDK (src/cloudflare/workers/first-wake.ts).
	"name": "flue-codemode-workers-tests",
	"main": "./test-worker.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"worker_loaders": [{ "binding": "LOADER" }],
	"durable_objects": {
		"bindings": [
			{ "name": "AGENT", "class_name": "CodemodeTestAgent" },
			{ "name": "CODEMODE_RUNTIME", "class_name": "CodemodeRuntime" },
			{ "name": "SQLITE_PROBE", "class_name": "SqliteProbe" },
			{ "name": "FIRST_WAKE", "class_name": "FirstWakeAgent" },
			{ "name": "CODEMODE_TURN", "class_name": "CodemodeTurnAgent" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CodemodeTestAgent",
				"SqliteProbe",
				"FirstWakeAgent",
				"CodemodeTurnAgent"
			]
		}
	]
}
